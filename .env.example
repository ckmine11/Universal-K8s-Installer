# Backend Environment Variables
NODE_ENV=production
PORT=3000

# CORS — comma-separated list of allowed frontend origins
# Production example: ALLOWED_ORIGINS=https://k8scluster.space
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Stripe (required for billing — webhook will reject all events without this)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=
# Local testing only: STRIPE_MOCK=true lets the checkout grant PRO without a
# Stripe key (never honoured when NODE_ENV=production). Leave unset otherwise.
# STRIPE_MOCK=
# Production example: FRONTEND_URL=https://k8scluster.space
FRONTEND_URL=http://localhost:5173

# Demo only: when the master node is unreachable over SSH, fake a successful
# install instead of failing. Default (unset) = fail the install.
# KUBEEZ_ALLOW_SIMULATION=true

# Domain (used internally for agent install scripts etc.)
DOMAIN=k8scluster.space

# Frontend Environment Variables (build time)
VITE_API_URL=http://localhost:3000

# Optional: Database (for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/kubeez

# Optional: Redis (for future use)
# REDIS_URL=redis://localhost:6379

# Email — password reset codes ("Forgot Password?") and email alerts.
# Without SMTP_USER/SMTP_PASS the login page tells users to ask an admin.
# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords) and use it as SMTP_PASS.
# Other providers (Brevo, Resend, Amazon SES, Zoho…): use their SMTP host/port.
# Port 465 = TLS; 587 = STARTTLS (set automatically; SMTP_SECURE overrides).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# EMAIL_FROM="KubeEZ <you@gmail.com>"
