# Dependencies
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.local

# Environment variables
.env
.env.local
.env.development
!.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
backend/logs/*.log

# SSH Keys and secrets (never commit these!)
*.pem
*.key
id_rsa*

# Sensitive runtime data — users (password hashes), agent tokens, clusters
# (encrypted SSH creds), license keys. The backend creates these on first run.
backend/data/*.json
backend/data/master.key
backend/data/backups/
backend/scripts/vendor-keys/

# Kubeconfig files
*kubeconfig*
admin.conf
config.yaml

# Allow vital config files
!docker-compose.yml
!frontend/vite.config.js
!frontend/tailwind.config.js
!frontend/postcss.config.js

# OS
Thumbs.db
.DS_Store

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Database
*.db
*.sqlite
*.sqlite3

# Certificates
*.crt
*.cert
*.ca-bundle

# Built by backend/build-agent.js (Dockerfile / tests) — never commit
backend/public/agent-bundle.js
